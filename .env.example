# Copy to .env and fill in. trains.py reads the nearest .env above it;
# variables already set in the environment take precedence.

# Realtime Trains API token (free personal tier): https://api-portal.rtt.io
RTT_API_TOKEN=

# Optional: a self-hosted Huxley 2 proxy and National Rail Darwin token,
# for when the public Huxley demo is down.
# HUXLEY_URL=
# DARWIN_ACCESS_TOKEN=
